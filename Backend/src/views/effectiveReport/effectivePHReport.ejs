<!DOCTYPE html>
<html>
<head>
  <style>
    body {
      font-family: Arial, sans-serif;
      font-size: 14px;
      margin: 20px;
      line-height: 1.6;
    }

    .report-content {
      margin-top: 30px;
      page-break-before: always;
    }

    h1, h2 {
      margin-bottom: 20px;
      text-align: left;
      clear: both;
    }

    h1 {
      font-size: 24px;
    }

    h2 {
      font-size: 18px;
      color: #0066CC;
    }

    p {
      font-size: 14px;
      margin-bottom: 10px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 30px;
      border: 1px solid #000;
    }

    th, td {
      border: 1px solid #000;
      padding: 10px;
      text-align: left;
    }

    th {
      background-color: #f8f8f8;
      font-weight: bold;
    }

    .remarks {
      page-break-inside: avoid;
    }

    .heading {
      padding-top: 10px;
      text-align: center;
    }

    .green {
      color: green;
      font-weight: bold;
    }

    .red {
      color: red;
      font-weight: bold;
    }

    .black {
      color: black;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <div class="report-content">
    <h2 class="heading">PH Meter (Multiparameter) Record</h2>

    <% if (reportData.OpAndCalMultiParameterProcessRecords && reportData.OpAndCalMultiParameterProcessRecords.length > 0) { %>
      <table >
        <thead>
          <tr>
            <th>Sr. No</th>
            <th>Date</th>
            <th>Instrument/Equipment Name</th>
            <th>Instrument/Equipment No.</th>
            <th>Name of Solution/Buffer/Sample Solution</th>
            <th>Adjusted pH</th>
            <th>Factor Value</th>
        </tr>
        <tr>
            <!-- <th>Sr. No</th> -->
            <th></th>
            <th>Done by</th>
            <th>Checked By</th>
            <th>Remarks	</th>
            <th>Attachment</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% reportData.OpAndCalMultiParameterProcessRecords.forEach((record, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td ><%= record?.date || "Not Applicable" %></td>
              <td><%= record?.instrument_name || "Not Applicable" %></td>
              <td><%= record?.instrument_no || "Not Applicable" %></td>
              <td><%= record?.nameOfSolution || "Not Applicable" %></td>
              <td><%= record?.adjustPH || "Not Applicable" %></td>
              <td><%= record?.factorValue || "Not Applicable" %></td>
            </tr> 
            <tr>
              <!-- <td><%= index + 1 %></td> -->
               <td></td>
              <td><%= record?.done_by || "Not Applicable" %></td>
              <td><%= record?.reviewed_by || "Not Applicable" %></td>
              <td><%= record?.remarks || record?.remarksOther || "Not Applicable" %></td>
              <td style="word-break: break-word;">
                <% if (record?.supporting_docs) { %>
                  <a href="<%= record.supporting_docs %>" target="_blank">
                    <%= record.supporting_docs.split('/').pop() %>
                  </a>
                  <% } else { %>
                    Not Applicable
                    <% } %>
                  </td>
                  <td><%= record?.status || "Not Applicable" %></td>                  
            </tr> 
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p>No Records Found.</p>
    <% } %>
  </div>
</body>
</html>
