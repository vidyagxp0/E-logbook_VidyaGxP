<!DOCTYPE html>
<html>
<head>
  <style>
    body {
      font-family: Arial, sans-serif;
      font-size: 14px;
      margin: 20px;
      line-height: 1.6;
    }

    .report-content {
      margin-top: 30px;
    }

    h1, h2 {
      margin-bottom: 20px;
      text-align: left;
      clear: both;
    }

    h1 {
      font-size: 24px;
    }

    h2 {
      font-size: 18px;
      color: #0066CC;
    }

    p {
      font-size: 14px;
      margin-bottom: 10px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 30px;
      border: 1px solid #000;
    }

    th, td {
      border: 1px solid #000;
      padding: 10px;
      text-align: left;
    }

    th {
      background-color: #f8f8f8;
      font-weight: bold;
    }

    .remarks {
      page-break-inside: avoid;
    }

    .heading {
      padding-top: 35px;
      text-align: center;
    }

    .green {
      color: green;
      font-weight: bold;
    }

    .red {
      color: red;
      font-weight: bold;
    }

    .black {
      color: black;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <div class="report-content">
    <h2 class="heading">Analytical Balance Record</h2>

    <% if (reportData.AnalyticalBalances && reportData.AnalyticalBalances.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>Sr. No</th>
            <th style="text-align: center;">Date</th>
            <th>Reg. No./Lot No.</th>
            <th>Sample Name</th>
            <th>Weight Taken</th>
            <th>Done By</th>
            <th>Checked By</th>
            <th>Reviewed By</th>
            <th>Remark</th>
            <th style="text-align: center;">Attachment</th>
          </tr>
        </thead>
        <tbody>
          <% reportData.AnalyticalBalances.forEach((record, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td style="white-space: nowrap; text-align: center;" ><%= record?.date || "Not Applicable" %></td>
              <td><%= record?.reg_no || "Not Applicable" %></td>
              <td><%= record?.sample_name || "Not Applicable" %></td>
              <td><%= record?.weight_taken || "Not Applicable" %></td>
              <td><%= record?.done_by || "Not Applicable" %></td>
              <td><%= record?.checked_by || "Not Applicable" %></td>
              <td><%= record?.reviewed_by || "Not Applicable" %></td>
              <td><%= record?.remarks || "Not Applicable" %></td>
              <td>
                <% if (record?.supporting_docs) { %>
                  <a href="<%= record.supporting_docs %>" target="_blank">
                    <%= record.supporting_docs.split('/').pop() %>
                  </a>
                  <% } else { %>
                    Not Applicable
                    <% } %>
                  </td>
                  
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p>No Records Found.</p>
    <% } %>
  </div>
</body>
</html>
