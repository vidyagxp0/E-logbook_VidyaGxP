<!DOCTYPE html>
<html>
<head>
    
  <style>
    body {
        font-family: Arial, sans-serif;
        font-size: 14px;
        margin: 20px;
        line-height: 1.6;
      }
      
      .report-content {
        margin-top: 30px; /* Increase margin top for more spacing */
      }
      
      h1, h2 {
        margin-bottom: 20px;
        text-align: left; /* Align headings to the left */
        clear: both; /* Clear floats to prevent overlap */
      }
      
      h1 {
        font-size: 24px;
      }
      
      h2 {
        font-size: 18px;
        color: #0066CC;
      }
      
      p {
        font-size: 14px;
        margin-bottom: 10px;
      }
      
      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 30px; /* Increase margin bottom for more spacing */
        border: 1px solid #000; /* Add border to the table */
      }
      
      th, td {
        border: 1px solid #000; /* Add border to table cells */
        padding: 10px; /* Adjusted padding for better spacing */
        text-align: left;
      }
      
      th {
        background-color: #f8f8f8;
        font-weight: bold;
      }
      
      .remarks {
        page-break-inside: avoid;
      }
      .heading
      {
        padding-top: 35px;
      }
            .green {
        color: green;
        font-weight: bold;
    }
    .red {
        color: red;
        font-weight: bold;
    }
    .black {
        color: black;
        font-weight: bold;
    }

      </style>
      
    
    <body>
    <div class="report-content">
        <h2 class="heading">HPLC Records</h2>
         <hr />
        <% if (reportData.hplcRecords && reportData.hplcRecords.length > 0) { %>
            <% reportData.hplcRecords.forEach(record => { %>
            <div class="listItem">
                <table>
                    <tr>
                        <th>Date</th>
                        <td><%= record?.date || "Not Applicable" %></td>
                        <th>Sample Name</th>
                        <td><%= record?.sample_name || "Not Applicable" %></td>
                    </tr>
                    <tr>
                        <th>Reg No./ Lot No.</th>
                        <td><%= record?.reg_no || "Not Applicable" %></td>
                        <th>Method Used</th>
                        <td><%= record?.method_used || "Not Applicable" %></td>

                    </tr>
                    <tr>
                        <th>Parameter/Activity</th>
                        <td><%= record?.parameter_or_activity || "Not Applicable" %></td>
                        <th>Column No.</th>
                        <td><%= record?.column_no || "Not Applicable" %></td>
                    </tr>

                    <tr>
                        <th>Start Time</th>
                        <td><%= record?.start_time || "Not Applicable" %></td>
                        <th>End Time</th>
                        <td><%= record?.end_time || "Not Applicable" %></td>
                    </tr>
                    <tr>
                        <th>No. of Injections</th>
                        <td><%= record?.no_of_injections || "Not Applicable" %></td>
                        <th>Done by</th>
                        <td><%= record?.done_by || "Not Applicable" %></td>
                    </tr>
                    <tr>

                        <th>Remark</th>
                        <td><%= record?.remarks || "Not Applicable" %></td>
                      <th>Checked By</th>
                        <td> <%= record?.reviewed_by || "Not Applicable" %> </td>
                    </tr>
                    <tr>

                    </tr>
                    <tr>
  
                    </tr>
                </table>
            </div>
            <% }) %>
        <% } else { %>
            <p>No Records Found.</p>
            <hr />
        <% } %>

        <div class="remarks">
            <h2 class="heading">Additional</h2>
            <table>
                <tr>
                    <th>Additional Attachment</th>
                    <td>
                        <% if (reportData?.additionalAttachment) { %>
                            <a href="<%= reportData.additionalAttachment %>" target="_blank">View File</a>
                        <% } else { %>
                            Not Applicable
                        <% } %>
                    </td>
                </tr>
                <tr>
                    <th>Addtional Info</th>
                    <td><%= (reportData?.additionalInfo || "Not Applicable") %></td>
                </tr>
                
            </table>
        </div>
    
        <hr />
    </div>
</body>
</html>
